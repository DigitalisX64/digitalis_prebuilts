// Minimal stub host modules required by Soong's python_binary_host graph.
// None of the translator's Python build helpers link libsqlite or compile
// .proto files; stubbing them avoids pulling external/sqlite, host ICU,
// external/protobuf, and abseil into the reduced tree.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_host_shared {
    name: "libsqlite",
    srcs: ["empty.c"],
    stl: "none",
}

sh_binary_host {
    name: "aprotoc",
    src: "aprotoc.sh",
}

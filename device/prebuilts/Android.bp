// Prebuilt x86_64 AOSP framework libraries that libberberis_proxy_* link
// against. Populated under x86_64/ by scripts/fetch_aosp_libs.py from the
// pinned AOSP x86_64 target_files archive for the matching AOSP release.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "digitalis_framework_prebuilt_defaults",
    compile_multilib: "64",
    installable: false,
    strip: {
        none: true,
    },
    system_shared_libs: [],
    stl: "none",
    header_libs: ["digitalis_framework_headers"],
    export_header_lib_headers: ["digitalis_framework_headers"],
}

cc_prebuilt_library_shared {
    name: "libEGL",
    defaults: ["digitalis_framework_prebuilt_defaults"],
    prefer: true,
    check_elf_files: false,
    srcs: ["x86_64/libEGL.so"],
}

cc_prebuilt_library_shared {
    name: "libGLESv1_CM",
    defaults: ["digitalis_framework_prebuilt_defaults"],
    prefer: true,
    check_elf_files: false,
    srcs: ["x86_64/libGLESv1_CM.so"],
}


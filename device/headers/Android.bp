// Header-only modules standing in for sparse-checked-out AOSP projects whose
// own Android.bp files are excluded from the reduced tree. scripts/build.sh
// copies each directory listed in include-dirs.txt under this folder so Soong's
// export_include_dirs stays within the module directory.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "hwvulkan_headers",
    host_supported: true,
    native_bridge_supported: true,
    vendor_available: true,
    header_libs: [
        "libcutils_headers",
        "libhardware_headers",
    ],
    export_header_lib_headers: [
        "libcutils_headers",
        "libhardware_headers",
    ],
    export_include_dirs: ["frameworks/native/vulkan/include"],
}

cc_library_headers {
    name: "libopenjdkjvmti_headers",
    host_supported: true,
    native_bridge_supported: true,
    export_include_dirs: ["art/openjdkjvmti/include"],
}

cc_library_headers {
    name: "digitalis_framework_headers",
    export_include_dirs: [
        "frameworks/av/camera/ndk/include",
        "frameworks/av/media/libaaudio/include",
        "frameworks/av/media/ndk/include",
        "frameworks/base/core/jni/include",
        "frameworks/base/media/native/midi/include",
        "frameworks/native/include",
        "frameworks/native/libs/arect/include",
        "frameworks/native/libs/binder/ndk/include_cpp",
        "frameworks/native/libs/binder/ndk/include_ndk",
        "frameworks/native/libs/binder/ndk/include_platform",
        "frameworks/native/libs/nativebase/include",
        "frameworks/native/libs/nativewindow/include",
        "frameworks/native/opengl/include",
        "frameworks/native/vulkan/include",
        "frameworks/wilhelm/include",
        "libnativehelper/include",
        "libnativehelper/include_platform",
    ],
    header_libs: [
        "jni_headers",
        "libcutils_headers",
        "libhardware_headers",
        "liblog_headers",
        "libnativehelper_header_only",
        "libsystem_headers",
        "libutils_headers",
        "vulkan_headers",
    ],
    export_header_lib_headers: [
        "jni_headers",
        "libcutils_headers",
        "libhardware_headers",
        "liblog_headers",
        "libnativehelper_header_only",
        "libsystem_headers",
        "libutils_headers",
        "vulkan_headers",
    ],
}
